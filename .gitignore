# ============================================================
# CrimeGraph AI — .gitignore
# Node.js / React / Vite / TypeScript monorepo
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ────────────────────────────────────────────
dist/
build/
out/
.output/
apps/web/dist/
apps/api/dist/

# ── Environment / secrets ────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
# Keep .env.example
!.env.example
!apps/api/.env.example

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Vite ─────────────────────────────────────────────────────
.vite/
apps/web/.vite/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editors ──────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Testing ──────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────────────────
.cache/
*.tgz
*.zip
