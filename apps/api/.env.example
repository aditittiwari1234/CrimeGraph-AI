# CrimeGraph AI — API Environment Variables
# Copy to .env and fill in values

NODE_ENV=development
PORT=3001

# JWT
JWT_SECRET=crimegraph_jwt_secret_change_in_production_min32chars
JWT_REFRESH_SECRET=crimegraph_refresh_secret_change_in_production_min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgresql://crimegraph:crimegraph_dev@localhost:5432/crimegraph_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crimegraph_db
DB_USER=crimegraph
DB_PASSWORD=crimegraph_dev

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=crimegraph_neo4j

# Redis (optional)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
